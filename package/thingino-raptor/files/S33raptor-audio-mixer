#!/bin/sh
# S33raptor-audio-mixer -- reapply persisted mic/speaker mixer settings once
# rad is up. Runs after S31raptor since raptorctl itself doesn't persist
# these settings (see raptor-audio-mixer-apply for the full explanation).

DAEMON=/usr/sbin/raptor-audio-mixer-apply

start() {
	[ -x "$DAEMON" ] || return 0
	[ -x /usr/bin/rad ] || return 0

	i=0
	while [ $i -lt 30 ] && ! pidof rad >/dev/null 2>&1; do
		usleep 100000
		i=$((i + 1))
	done
	pidof rad >/dev/null 2>&1 || return 0

	"$DAEMON"
}

case "$1" in
	start)
		start
		;;
	stop)
		: ;;
	restart)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
