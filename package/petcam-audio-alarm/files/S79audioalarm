#!/bin/sh
# S79audioalarm -- start/stop the audio-alarm daemon (needs rad/rac up, see
# S31raptor; runs well after it so the mic ring is already flowing).

DAEMON=/usr/sbin/audio-alarm
PIDFILE=/run/audio-alarm.pid
CONFIG_JSON=/etc/thingino.json

is_enabled() {
	[ -x "$DAEMON" ] || return 1
	command -v jct >/dev/null 2>&1 || return 1
	val=$(jct "$CONFIG_JSON" get audio_alarm.enabled 2>/dev/null)
	[ "$val" = "true" ]
}

start() {
	is_enabled || return 0
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "audio-alarm already running"
		return 0
	fi
	echo "Starting audio-alarm"
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

stop() {
	echo "Stopping audio-alarm"
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" 2>/dev/null
		rm -f "$PIDFILE"
	else
		start-stop-daemon -K -x "$DAEMON" 2>/dev/null
	fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
