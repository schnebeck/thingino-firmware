#!/bin/sh
# Treat dispense cycle for the petcam.
#
# Timeline (4s total):
#   t=0..2s   agitator stepper turns CW
#   t=1s      DC dispenser on (active-low)
#   t=2..4s   agitator turns CCW
#   DC dispenser off as soon as the stop sensor reports a full stroke
#   (independent of the agitator timing, with a safety timeout)

STEPPER=/usr/sbin/stepper
GPIO_DC=57
GPIO_SENSE=54
GPIO_SPARE=51

# 1600 half-steps @ 800 Hz = exactly 2.0s, verified on-device as "silky smooth"
AGITATE_STEPS=1600
AGITATE_SPEED=800

setup_gpio_dc() {
	[ -d /sys/class/gpio/gpio$GPIO_DC ] || echo $GPIO_DC >/sys/class/gpio/export
	echo out >/sys/class/gpio/gpio$GPIO_DC/direction 2>/dev/null
	echo 1 >/sys/class/gpio/gpio$GPIO_DC/value # active-low: 1 = off
}

setup_gpio_sense() {
	[ -d /sys/class/gpio/gpio$GPIO_SENSE ] || echo $GPIO_SENSE >/sys/class/gpio/export
	echo in >/sys/class/gpio/gpio$GPIO_SENSE/direction 2>/dev/null
}

# Vendor board table lists this as DCMOTOR-STOP-IRQ, and it's a real
# hardware interrupt in the original firmware (request_threaded_irq() in
# strnio.ko, confirmed by disassembly): the DC motor there is switched
# off exactly on this pin's falling edge, 20ms debounce, nothing else -
# GPIO_SENSE ("SLOW-IRQ" in the vendor table) turned out to only latch a
# timestamp in the original driver, not touch the motor at all. Used via
# gpio-wait below (edge-triggered poll(), not a busy-poll loop) as the
# authoritative stop condition instead of the coarse SENSE-polling this
# script used before that finding.
setup_gpio_spare() {
	[ -d /sys/class/gpio/gpio$GPIO_SPARE ] || echo $GPIO_SPARE >/sys/class/gpio/export
	echo in >/sys/class/gpio/gpio$GPIO_SPARE/direction 2>/dev/null
}

# Millisecond-resolution, from /proc/uptime (busybox date has no %N).
now_ms() {
	awk '{printf "%d", $1 * 1000}' /proc/uptime
}

dispense() {
	sleep 1
	echo "Dispense: DC on"
	echo 0 >/sys/class/gpio/gpio$GPIO_DC/value # active-low: 0 = on
	dc_on_ms=$(now_ms)

	# Clear the cam in case the sensor already reads 0 at power-on
	clear_ticks=0
	while [ "$(cat /sys/class/gpio/gpio$GPIO_SENSE/value)" = "0" ] && [ $clear_ticks -lt 40 ]; do
		usleep 25000
		clear_ticks=$((clear_ticks + 1))
	done

	# Wait for the STOP-IRQ (GPIO_SPARE): falling edge = piston reached the
	# top stop, spring released. A directly measured genuine trip never
	# landed under ~600ms after motor start - an event much earlier is a
	# false trigger (e.g. a still-settling/bouncing signal from the
	# previous cycle at arm time) and gets discarded; the wait keeps
	# running against the overall budget.
	budget_ms=5000
	min_real_ms=300
	ok=0
	elapsed=0
	while true; do
		remaining=$((budget_ms - ($(now_ms) - dc_on_ms)))
		[ $remaining -le 0 ] && break
		gpio-wait $GPIO_SPARE falling $remaining >/dev/null
		wait_status=$?
		[ $wait_status -ne 0 ] && break
		elapsed=$(($(now_ms) - dc_on_ms))
		if [ $elapsed -ge $min_real_ms ]; then
			ok=1
			break
		fi
		echo "Dispense: discarded false signal after ${elapsed}ms, still waiting" >&2
		usleep 10000
	done

	echo 1 >/sys/class/gpio/gpio$GPIO_DC/value # active-low: 1 = off

	if [ $ok -ne 1 ]; then
		echo "Dispense: timeout, no STOP signal (after ${elapsed}ms)" >&2
		return 1
	fi
	echo "Dispense: done after ${elapsed}ms (STOP signal received)"
	return 0
}

setup_gpio_dc
setup_gpio_sense
setup_gpio_spare

# Stepper whir + treats rattling into the bowl reads on the mic just like the
# pan motor and the sound buttons do - suppress the audio alarm for the same
# reason and via the same flag (see audio-alarm.c's self_noise_active()).
# trap covers early/error exit (e.g. a stepper failure) as well as the normal
# path, so the flag can never get stuck set.
touch /run/self-noise-active
trap 'rm -f /run/self-noise-active' EXIT

echo "Agitator: CW"
$STEPPER --steps $AGITATE_STEPS --speed $AGITATE_SPEED &
stepper_cw_pid=$!

dispense &
dispense_pid=$!

wait $stepper_cw_pid

echo "Agitator: CCW"
$STEPPER --steps -$AGITATE_STEPS --speed $AGITATE_SPEED

wait $dispense_pid
dispense_status=$?

echo "Cycle complete."
exit $dispense_status
