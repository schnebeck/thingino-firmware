#!/bin/sh
# shellcheck disable=SC2034

DAEMON="petcam-vpn-onconnect"
CRONTABS_FLASH="/etc/cron/crontabs/root"
CRONTABS_RAM="/run/cron/crontabs/root"
CRONTABS="$CRONTABS_RAM"

# VPN-backend-agnostic replacement for hooking into OpenVPN's --up (or any
# WireGuard equivalent): polls every minute for the configured VPN helper
# server becoming reachable and fires the on-connect actions itself. A
# no-op (exits immediately) while vpn_helper.remote is unset.
ensure_ram_crontab() {
	mkdir -p "$(dirname "$CRONTABS_RAM")"
	if [ ! -f "$CRONTABS_RAM" ]; then
		cp "$CRONTABS_FLASH" "$CRONTABS_RAM" 2>/dev/null || touch "$CRONTABS_RAM"
		chmod 600 "$CRONTABS_RAM"
	fi
}

start() {
	echo -c 15 "Starting $DAEMON cron entry"

	[ -x /usr/sbin/$DAEMON ] || return 0

	ensure_ram_crontab

	if grep -q "$DAEMON" "$CRONTABS_RAM" 2>/dev/null; then
		echo "$DAEMON already in crontab"
	else
		printf "# detect the VPN helper server coming up, any VPN backend\n* * * * * %s\n" \
			"$DAEMON" >>"$CRONTABS_RAM"
		echo "$DAEMON added to crontab"
	fi
}

stop() {
	echo -c 15 "Stopping $DAEMON cron entry"
	if [ -f "$CRONTABS_RAM" ]; then
		tmpfile=$(mktemp)
		sed "/$DAEMON/d" "$CRONTABS_RAM" >"$tmpfile"
		cp "$tmpfile" "$CRONTABS_RAM"
		rm -f "$tmpfile"
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
